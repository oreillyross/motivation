---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Motivation · a little nudge for today",
  description = "One good quote from the people I follow, every time I open the page.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Fira+Code:wght@400&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var s = null;
        try { s = localStorage.getItem("theme"); } catch (e) {}
        var d = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", d);
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <Nav />
    <slot />
  </body>
</html>
