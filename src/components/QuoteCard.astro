---
import type { Quote } from "../lib/quotes";

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
---

<figure class="relative mx-auto max-w-[48rem] rounded-wobble border border-border bg-card px-6 pt-8 pb-6 md:px-10 md:pt-12 md:pb-10 text-card-foreground">
  <span aria-hidden="true" class="absolute -top-[9px] left-1/2 h-[18px] w-16 -translate-x-1/2 -rotate-4 bg-accent"></span>
  <blockquote>
    <p data-quote-text class="text-h4 font-semibold sm:text-h3 md:text-[2.5rem] md:leading-[1.2]">{quote.text}</p>
  </blockquote>
  <figcaption data-quote-author class="mt-4 text-small font-semibold text-muted-foreground" hidden={!quote.author}>
    — <span>{quote.author}</span>
  </figcaption>
</figure>
