---
---

<header class="mx-auto flex h-16 max-w-[1040px] items-center justify-between px-5">
  <a href="/" class="font-display text-[1.75rem] leading-none font-bold text-foreground no-underline">
    Motivation
  </a>

  <button
    type="button"
    data-theme-toggle
    aria-label="Dark theme"
    aria-pressed="false"
    class="inline-flex size-11 items-center justify-center rounded-full border-2 border-foreground bg-card text-foreground shadow-hard transition-[transform,box-shadow,background-color] duration-150 ease-bounce hover:bg-accent hover:text-accent-foreground hover:shadow-hard-lg active:shadow-hard-sm motion-safe:hover:-translate-x-px motion-safe:hover:-translate-y-px motion-safe:active:translate-x-0.5 motion-safe:active:translate-y-0.5"
  >
    <!-- moon (shown in light mode) -->
    <svg class="dark:hidden" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="var(--deco-butter)" stroke="none" transform="translate(1.5 1.5)" />
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
    </svg>
    <!-- sun (shown in dark mode) -->
    <svg class="hidden dark:block" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="13.5" cy="13.5" r="4" fill="var(--primary)" stroke="none" />
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;

  const sync = () => button?.setAttribute("aria-pressed", String(root.classList.contains("dark")));
  sync();

  button?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      // storage blocked: theme still flips for this visit
    }
    sync();
  });
</script>
