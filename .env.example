# pnpm quotes:suggest needs ONE of these. If both are set, Anthropic is used
# unless you pass --provider openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the OpenAI model (default gpt-5-nano, the cheapest).
# OPENAI_MODEL=

# pnpm quotes:wikiquote: Wikimedia requires a contact (email or site) in the User-Agent.
WIKIQUOTE_CONTACT=
